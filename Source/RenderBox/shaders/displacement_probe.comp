#version 450
// STUB probe -- runs the stage as compute so the GPU's answer can be read back
// and compared with the oracle. Same shape as `path_probe.comp`.
#extension GL_GOOGLE_include_directive : require

#include "Displacement.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer In  { vec4 inputs[]; };
layout(std430, binding = 1) writeonly buffer Out { vec4 outputs[]; };

layout(push_constant) uniform Control {
    uint count;
    uint stage;
    uint state;
} control;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= control.count) return;
    outputs[i] = inputs[i];
}
