{
  "version": 6,
  "configurePresets": [
    { "name": "mingw", "generator": "Ninja", "binaryDir": "build/mingw",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_COMPILER": "g++" } },
    { "name": "mingw-asan", "inherits": "mingw", "binaryDir": "build/mingw-asan",
      "cacheVariables": { "IC_SANITIZE": "ON" } },
    { "name": "msvc", "generator": "Ninja", "binaryDir": "build/msvc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_COMPILER": "cl" } },
    { "name": "release", "generator": "Ninja", "binaryDir": "build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "mingw", "configurePreset": "mingw" },
    { "name": "mingw-asan", "configurePreset": "mingw-asan" },
    { "name": "msvc", "configurePreset": "msvc" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "mingw", "configurePreset": "mingw", "output": { "outputOnFailure": true } }
  ]
}
