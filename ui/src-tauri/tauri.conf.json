{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ui",
  "version": "0.1.0",
  "identifier": "com.jeanxpereira.iconcomposer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Icon Composer",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "transparent": false,
        "theme": "Light",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}